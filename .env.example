# Anthropic API key — powers the Claude review (claude-opus-5)
ANTHROPIC_API_KEY=

# OpenAI API key — powers the GPT review (gpt-5.6-sol)
OPENAI_API_KEY=

# Local access value for private deployments
APP_PASSWORD=

# Optional comma-separated public origins for CSRF protection behind proxies
APP_ORIGIN=

# Optional deployment id for rolling deploy version-skew protection
NEXT_DEPLOYMENT_ID=

# Optional server log verbosity: debug, info, warn, error, or silent
LOG_LEVEL=info
